<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) en dark mode : fond BLANC forcé quand même,
         pour supprimer l'écran noir au lancement (cohérence avec le splash Flutter). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
        <!-- Icône transparente : supprime le petit logo du splash natif -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
